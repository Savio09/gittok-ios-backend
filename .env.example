# Copy to .env and fill in. .env is gitignored; this template is committed.

# Required. A GitHub personal access token (classic or fine-grained) used to
# authenticate GitHub API requests. Without it the server refuses to start.
GITHUB_TOKEN=

# Optional. TCP port the HTTP server listens on. Defaults to 8080.
PORT=8080

# Optional. A separate credential for public repository previews: a classic
# personal access token (ghp_) created with NO scopes, which GitHub documents as
# read-only access to public information. It is verified at startup and on every
# response; a scoped, fine-grained or app token is rejected and the server stops.
# Never reuse GITHUB_TOKEN here. Empty selects anonymous access (60 requests/hour
# per outbound IP, shared on hosted platforms), which is not enough for a demo.
GITHUB_PUBLIC_TOKEN=

# Optional. How long a completed public preview is reused (Go duration). Default 30m.
PREVIEW_CACHE_TTL=30m

# Optional. Dedicated preview cache directory (created 0700). Defaults to a
# directory under the system temp dir; an ephemeral filesystem loses it on redeploy.
PREVIEW_CACHE_DIR=
